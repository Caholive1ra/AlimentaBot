# Apenas dados sintéticos de demonstração. Nunca inclua credenciais reais no repositório.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://alimentabot:alimentabot@localhost:5432/alimentabot
TEST_DATABASE_URL=postgresql+psycopg://alimentabot_test:alimentabot_test@localhost:5433/alimentabot_test

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth0/OIDC — preencha somente no backend/.env local ou no gerenciador de segredos.
# Exemplo de domínio: seu-tenant.us.auth0.com (sem https://).
AUTH0_DOMAIN=
# Identificador da API criado no painel Auth0, por exemplo https://api.exemplo.com/alimentabot.
AUTH0_AUDIENCE=
# Permite apenas os cabeçalhos X-Demo-* no ambiente local de demonstração.
# Nunca habilite em produção.
DEMO_MODE_ENABLED=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
MAX_REQUEST_BODY_BYTES=1048576

